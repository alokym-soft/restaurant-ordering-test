{
  "name": "@restaurant/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx watch src/main.ts",
    "start:chaos": "tsx watch --env-file=chaos.env src/main.ts",
    "build": "tsup",
    "serve": "node dist/main.js",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.4",
    "@restaurant/contracts": "*",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
